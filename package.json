{
  "name": "ts-template",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:codegen": "kysely-codegen --env-file .env --dialect postgres --out-file ./src/db/types.ts",
    "db:migrate": "kysely migrate:latest",
    "db:migrate:down": "kysely migrate:down",
    "db:migrate:list": "kysely migrate:list",
    "db:migrate:make": "kysely migrate:make",
    "db:migrate:reset": "kysely migrate:rollback --all",
    "db:migrate:up": "kysely migrate:up",
    "db:seed": "kysely seed:run",
    "db:seed:list": "kysely seed list",
    "db:seed:make": "kysely seed:make",
    "db:resync": "npm run db:migrate:down && npm run db:migrate:up && npm run db:codegen && npm run db:seed",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "private": true,
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "kysely": "^0.29.1",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^5.12.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  }
}
