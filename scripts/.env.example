# Copy to scripts/.env; existing database settings can stay in that file.
# Used only by the local endpoint testing client. Do not use these credentials in production.
API_BASE_URL=http://localhost:3000
API_AUTH=api-key
API_KEY=00000000-0000-0000-0000-000000000001.dev
API_USERNAME=Developer
API_PASSWORD=dev
# Optional: skips login in bearer mode; also used by minecraft mode.
# API_TOKEN=
API_TIMEOUT=30

