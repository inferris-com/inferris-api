NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PORT=3000

POSTGRES_DB=devdb
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://dev:dev@localhost:5432/devdb

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_MAX_DELAY_MS=3000

ADMINER_PORT=8080

AUTH_API_KEY_PEPPER=dev
AUTH_JWT_SECRET=development-auth-secret-change-me-at-least-32-chars
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600

CHAT_FLUSH_BATCH_SIZE=500
CHAT_FLUSH_INTERVAL_MS=1000
CHAT_MAX_BATCH_SIZE=500
CHAT_DEDUPE_TTL_SECONDS=604800
CHAT_ALLOWED_CLOCK_SKEW_MS=300000
